{
  "name": "black-veil",
  "version": "1.4.0",
  "type": "module",
  "description": "BLACK VEIL v1.4.0 FINAL - Cinematic 3D tactical shooter, multiplayer, 6 modes, AI, story per player, AAA animation, realism, 23 textures, 30 SVG icons, 55 PNG assets, Wasmer ready",
  "main": "electron/main.cjs",
  "homepage": "./",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc && vite build",
    "build:mobile": "tsc && vite build --mode mobile",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "preview:open": "vite preview --host 0.0.0.0 --port 4173 --open",
    "start": "node launch.mjs",
    "launch": "node launch.mjs",
    "launch:dev": "vite --host 0.0.0.0 --port 5173 --open",
    "mobile": "node server.cjs",
    "mobile:launch": "node launch.mjs",
    "pwa": "vite build && npx serve dist -l 4173",
    "electron": "npm run build && electron electron/main.cjs",
    "electron:dev": "electron electron/main.cjs",
    "dist": "npm run build && electron-builder --win --linux --mac",
    "dist:win": "npm run build && electron-builder --win",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "node scripts/generate-icons.mjs || true"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "pngjs": "^6.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vite-plugin-pwa": "^0.19.0",
    "vitest": "^1.6.0"
  },
  "build": {
    "appId": "com.m11dev.blackveil",
    "productName": "BLACK VEIL",
    "copyright": "Copyright © 2026 M11 Dev",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icons/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon-512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icons/icon-512.png",
      "category": "Game"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icons/icon-512.png",
      "category": "public.app-category.games"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BLACK VEIL"
    }
  },
  "keywords": [
    "black-veil",
    "game",
    "3d",
    "shooter",
    "stealth",
    "tactical",
    "pwa",
    "threejs"
  ],
  "author": "M11 Dev <ma7292537@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/M11-Developer/Black-Viel.git"
  }
}
