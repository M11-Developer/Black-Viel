{
  "name": "BLACK VEIL - THE CITY FORGOT. YOU DIDN'T.",
  "short_name": "BLACK VEIL",
  "start_url": "./index.html",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "background_color": "#050508",
  "theme_color": "#0a0a0f",
  "lang": "en",
  "dir": "ltr",
  "scope": "./",
  "description": "THE CITY FORGOT. YOU DIDN'T. Cinematic 3D tactical stealth action in Veyra megacity. One-tap mobile, PWA, offline, gyro, haptics. M11 Dev.",
  "orientation": "any",
  "categories": ["games", "action", "entertainment"],
  "screenshots": [
    {
      "src": "public/assets/mobile/background.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "BLACK VEIL Mobile Gameplay"
    }
  ],
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"},
    {"src": "public/assets/characters/player.png", "sizes": "512x512", "type": "image/png", "purpose": "any"}
  ],
  "shortcuts": [
    {"name": "Play Now", "short_name": "Play", "description": "One-tap play", "url": "./index.html", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192"}]},
    {"name": "Mobile Launcher", "short_name": "Mobile", "description": "One-click mobile launcher", "url": "./mobile.html", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192"}]},
    {"name": "Photo Mode", "short_name": "Photo", "description": "Photo mode", "url": "./index.html?photomode=1", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192"}]}
  ],
  "launch_handler": {"client_mode": "focus-existing"},
  "handle_links": "preferred",
  "edge_side_panel": {"preferred_width": 400},
  "file_handlers": [{"action": "./index.html", "accept": {"image/*": [".png",".jpg"]}}],
  "share_target": {"action": "./index.html", "method": "GET", "params": {"title": "title", "text": "text", "url": "url"}},
  "protocol_handlers": [{"protocol": "web+blackveil", "url": "./index.html?protocol=%s"}]
}
